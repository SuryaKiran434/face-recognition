# Email credentials for door notifications (Gmail).
# Copy to ".env" in this repo's root (gitignored) and fill in all three values.
# There is no fallback to any other location; a real environment variable of the
# same name overrides the file.
#
# The password is a Google "App password" (not your account password):
#   Google Account -> Security -> 2-Step Verification -> App passwords.
SENDER_EMAIL=you@gmail.com
SENDER_APP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=you@gmail.com
