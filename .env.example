# Email credentials for door notifications (Gmail).
# Copy to ".env" (gitignored) and fill in, OR rely on the automatic fallback
# to ~/IdeaProjects/BrewAutomation/.env if you already configured it there.
#
# The password is a Google "App password" (not your account password):
#   Google Account -> Security -> 2-Step Verification -> App passwords.
SENDER_EMAIL=you@gmail.com
SENDER_APP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=you@gmail.com
